import { Router } from "express";
import { authenticate } from "../middleware/auth.js";
import { requireRole } from "../middleware/requireRole.js";
import {
  getKycApplicationDetails,
  listKycApplications,
} from "../controllers/kycReview.controller.js";

const router = Router();

router.use(authenticate, requireRole("KYC_OFFICER"));
router.get("/applications", listKycApplications);
router.get("/applications/:applicationId", getKycApplicationDetails);

export default router;
